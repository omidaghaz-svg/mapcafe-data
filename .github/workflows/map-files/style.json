{
  "version": 8,
  "glyphs": "glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "iran": {
      "type": "vector",
      "tiles": ["tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f8f4f0" } },
    { "id": "water", "type": "fill", "source": "iran", "source-layer": "water", "paint": { "fill-color": "#a0c8f0" } },
    { "id": "park", "type": "fill", "source": "iran", "source-layer": "landcover", "filter": ["==", "class", "grass"], "paint": { "fill-color": "#d4e8c4" } },
    { "id": "residential", "type": "fill", "source": "iran", "source-layer": "landuse", "filter": ["==", "class", "residential"], "paint": { "fill-color": "#e8e0d8" } },
    { "id": "road-major", "type": "line", "source": "iran", "source-layer": "transportation", "filter": ["in", "class", "motorway", "trunk", "primary"], "paint": { "line-color": "#f8b500", "line-width": 2.5 } },
    { "id": "road-minor", "type": "line", "source": "iran", "source-layer": "transportation", "filter": ["in", "class", "secondary", "tertiary"], "paint": { "line-color": "#ffffff", "line-width": 1.5 } },
    { "id": "admin-boundary", "type": "line", "source": "iran", "source-layer": "boundary", "filter": ["==", "admin_level", 2], "paint": { "line-color": "#9e6b6b", "line-width": 1.5, "line-dasharray": [4, 3] } },
    { "id": "place-city", "type": "symbol", "source": "iran", "source-layer": "place", "filter": ["==", "class", "city"], "layout": { "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]], "text-font": ["Noto Sans Arabic Regular"], "text-size": 14 }, "paint": { "text-color": "#333", "text-halo-color": "#fff", "text-halo-width": 1 } },
    { "id": "place-town", "type": "symbol", "source": "iran", "source-layer": "place", "filter": ["==", "class", "town"], "layout": { "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]], "text-font": ["Noto Sans Arabic Regular"], "text-size": 11 }, "paint": { "text-color": "#555", "text-halo-color": "#fff", "text-halo-width": 0.8 } }
  ]
}
